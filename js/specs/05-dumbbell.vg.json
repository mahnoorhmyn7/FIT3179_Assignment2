          "fold": [
            "breeding",
            "release"
          ],
          "as": [
            "activity",
            "count"
          ]
        }
      ],
      "mark": {
        "type": "circle",
        "filled": true,
        "size": 160,
        "stroke": "#fff",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "count",
          "type": "quantitative"
        },
        "y": {
          "field": "site",
          "type": "nominal",
          "title": null,
          "sort": [
            "Perth Zoo",
            "Taronga Sydney",
            "Taronga Dubbo",
            "Healesville",
            "Adelaide Zoo",
            "Australia Zoo"
          ]
        },
        "color": {
          "field": "activity",
          "type": "nominal",
          "scale": {
            "domain": [
              "breeding",
              "release"
            ],
            "range": [
              "#bc7044",
              "#2f6652"
            ]
          },
          "legend": {
            "title": null,
            "orient": "bottom",
            "labelExpr": "datum.label == 'breeding' ? 'Breeding / care' : 'Release / return'"
          }
        },
        "tooltip": [
          {
            "field": "site",
            "type": "nominal"
          },
          {
            "field": "activity",
            "type": "nominal"
          },
          {
            "field": "count",
            "type": "quantitative",
            "title": "Program mentions"
          }
        ]
      }
    }
