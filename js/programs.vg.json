{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "data/programs.csv"
  },
  "width": "container",
  "height": {
    "step": 31
  },
  "transform": [
    {
      "calculate": "datum.species + ' · ' + datum.site",
      "as": "program_label"
    },
    {
      "fold": [
        "breeding",
        "release",
        "habitat",
        "research"
      ],
      "as": [
        "activity",
        "present"
      ]
    },
    {
      "filter": "toNumber(datum.present) == 1"
    },
    {
      "calculate": "datum.activity=='breeding' ? 'Breed & protect' : datum.activity=='release' ? 'Release & return' : datum.activity=='habitat' ? 'Restore habitat' : 'Research & care'",
      "as": "activity_name"
    }
  ],
  "mark": {
    "type": "rect",
    "cornerRadius": 4,
    "stroke": "white",
    "strokeWidth": 2,
    "cursor": "pointer"
  },
  "encoding": {
    "x": {
      "field": "activity_name",
      "type": "nominal",
      "sort": [
        "Breed & protect",
        "Release & return",
        "Restore habitat",
        "Research & care"
      ],
      "axis": {
        "title": null,
        "labelAngle": 0,
        "labelLimit": 135,
        "labelFontSize": 11,
        "labelPadding": 9,
        "orient": "top"
      }
    },
    "y": {
      "field": "program_label",
      "type": "nominal",
      "sort": {
        "field": "site",
        "op": "min",
        "order": "ascending"
      },
      "axis": {
        "title": null,
        "labelLimit": 230,
        "labelFontSize": 11,
        "labelPadding": 7
      }
    },
    "color": {
      "field": "activity_name",
      "type": "nominal",
      "scale": {
        "domain": [
          "Breed & protect",
          "Release & return",
          "Restore habitat",
          "Research & care"
        ],
        "range": [
          "#496f55",
          "#a47d44",
          "#759d8c",
          "#a6b68b"
        ]
      },
      "legend": null
    },
    "tooltip": [
      {
        "field": "species",
        "title": "Species"
      },
      {
        "field": "site",
        "title": "Zoo / sanctuary"
      },
      {
        "field": "program",
        "title": "Documented project"
      },
      {
        "field": "activity_name",
        "title": "Action"
      },
      {
        "field": "note",
        "title": "Details"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "grid": false,
      "domain": false,
      "tickSize": 0
    },
    "background": null
  }
}